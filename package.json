{
  "name": "wayfarer-zero",
  "private": true,
  "version": "0.1.0-alpha",
  "type": "module",
  "description": "WAYFARER ZERO — 2D side-scrolling action-adventure. Phaser 4 + TypeScript, with a Phaser-free rules core.",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "check": "npm run typecheck && npm run test:run && npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "7.0.2",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "phaser": "4.2.1"
  }
}
